# MONGODB_URI: MongoDB connection string for persistent multi-user storage.
MONGODB_URI="mongodb://127.0.0.1:27017/tid_planner"

# GROQ_API_KEY: Required for Groq LLM task understanding & constraint extraction.
GROQ_API_KEY="YOUR_GROQ_API_KEY"
GROQ_MODEL="openai/gpt-oss-120b"

# JWT_SECRET: Secret key used to sign HTTP-only session cookies.
JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"

# GEMINI_API_KEY: Provided by AI Studio runtime environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
